@page
@model MetroTicketSystem.Pages.Page2Model

@{
    ViewData["Title"] = Model.IsVietnamese ? "Thanh toán" : "Payment";
    Layout = null;
}

<!DOCTYPE html>
<html lang="@(Model.IsVietnamese ? "vi" : "en")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        header:not(.payment-header), footer, .border-top.footer {
            display: none !important;
        }

        body {
            margin: 0;
            padding: 0;
            background: #f5f6f8;
            font-family: Arial, sans-serif;
        }

        .payment-page {
            min-height: 100vh;
            background: #f5f6f8;
            color: #222;
        }

        .payment-header {
            height: 95px;
            background: #3987ed;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 5px #bbb;
        }

        .payment-header h1 {
            font-size: 36px;
            font-weight: bold;
            margin: 0;
        }

        .payment-content {
            max-width: 900px;
            margin: auto;
            padding: 35px 35px;
        }

        .payment-box {
            background: white;
            border-radius: 12px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 2px 8px #ddd;
        }

        .payment-title {
            font-size: 28px;
            font-weight: bold;
            margin-bottom: 22px;
            line-height: 1.2;
        }

        .quantity-control {
            display: flex;
            align-items: center;
            gap: 25px;
            margin-bottom: 30px;
        }

        .quantity-control button {
            width: 52px;
            height: 52px;
            border: 2px solid #3987ed;
            border-radius: 8px;
            background: white;
            color: #3987ed;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .quantity-control button:disabled {
            border-color: #ccc;
            color: #ccc;
            cursor: not-allowed;
        }

        #quantity {
            font-size: 28px;
            font-weight: bold;
            min-width: 40px;
            text-align: center;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            padding: 14px 0;
            border-bottom: 1px solid #eee;
            font-size: 22px;
        }

        .total-row {
            color: #2469c4;
            font-size: 26px;
            font-weight: bold;
            border-bottom: none;
            margin-top: 10px;
            padding-top: 18px;
        }

        .payment-methods {
            display: flex;
            gap: 18px;
        }

        .method-button {
            flex: 1;
            min-height: 80px;
            padding: 15px;
            background: white;
            border: 2px solid #b8c4d4;
            border-radius: 10px;
            font-size: 22px;
            font-weight: 500;
            cursor: pointer;
            transition: 0.2s;
        }

        .method-button:hover {
            border-color: #3987ed;
            background: #edf5ff;
        }

        .method-button.selected {
            background: #dceaff;
            border: 3px solid #3987ed;
            color: #1458a8;
            font-weight: bold;
        }

        .payment-actions {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            margin-top: 30px;
        }

        .action-button {
            padding: 16px 35px;
            border: none;
            border-radius: 8px;
            font-size: 22px;
            font-weight: bold;
            cursor: pointer;
        }

        .back-button {
            background: #e4e7eb;
            color: #333;
        }

        .back-button:hover {
            background: #d5d9df;
        }

        .pay-button {
            background: #4d922f;
            color: white;
        }

        .pay-button:hover {
            background: #3e7825;
        }

        .pay-button:disabled {
            background: #aaa;
            cursor: not-allowed;
        }

        .validation-message {
            color: #d32f2f;
            margin-top: 15px;
            font-size: 18px;
        }

        @@media (max-width: 650px) {
            .payment-header {
                height: 80px;
            }

            .payment-header h1 {
                font-size: 26px;
            }

            .payment-content {
                padding: 22px 15px;
            }

            .payment-title {
                font-size: 22px;
            }

            .info-row {
                font-size: 18px;
            }

            .total-row {
                font-size: 22px;
            }

            .payment-methods {
                flex-direction: column;
            }

            .method-button {
                font-size: 18px;
                min-height: 65px;
            }

            .payment-actions {
                flex-direction: column;
            }

            .action-button {
                font-size: 20px;
                width: 100%;
            }
        }
    </style>
</head>
<body>

<div class="payment-page">

    <header class="payment-header">
        <h1>
            @(Model.IsVietnamese ? "Thanh toán" : "Payment")
        </h1>
    </header>

    <main class="payment-content">

        <section class="payment-box">

            <div class="payment-title">
                @(Model.IsVietnamese ? "Số lượng vé" : "Ticket Quantity")
            </div>

            <div class="quantity-control">
                <button type="button" id="decrease">−</button>
                <span id="quantity">1</span>
                <button type="button" id="increase">+</button>
            </div>

            <div class="payment-title">
                @(Model.IsVietnamese ? "Thông tin thanh toán" : "Payment Information")
            </div>

            <div class="info-row">
                <span>@(Model.IsVietnamese ? "Ga đi" : "Departure")</span>
                <strong>Bến Thành</strong>
            </div>

            <div class="info-row">
                <span>@(Model.IsVietnamese ? "Ga đến" : "Destination")</span>
                <strong>@(Model.IsVietnamese ? Model.DestinationName : Model.Destination)</strong>
            </div>

            <div class="info-row">
                <span>@(Model.IsVietnamese ? "Hình thức vé" : "Trip Type")</span>
                <strong>
                    @if (Model.TripType == "roundtrip")
                    {
                        @(Model.IsVietnamese ? "Khứ hồi" : "Round trip")
                    }
                    else
                    {
                        @(Model.IsVietnamese ? "Một chiều" : "One-way")
                    }
                </strong>
            </div>

            <div class="info-row">
                <span>@(Model.IsVietnamese ? "Giá một vé" : "Price per ticket")</span>
                <span id="ticketPrice" data-price="@Model.TicketPrice">
                    @Model.TicketPrice.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) đ
                </span>
            </div>

            <div class="info-row">
                <span>@(Model.IsVietnamese ? "Số lượng" : "Quantity")</span>
                <span id="summaryQuantity">1</span>
            </div>

            <div class="info-row total-row">
                <span>@(Model.IsVietnamese ? "Thành tiền" : "Total")</span>
                <span id="totalPrice"></span>
            </div>

        </section>

        <section class="payment-box">

            <div class="payment-title">
                @(Model.IsVietnamese ? "Hình thức thanh toán" : "Payment Method")
            </div>

            <div class="payment-methods">

                <button type="button" class="method-button" data-method="card">
                    💳 @(Model.IsVietnamese ? "Thẻ ngân hàng" : "Bank Card")
                </button>

                <button type="button" class="method-button" data-method="qr">
                    ▦ QR Online
                </button>

            </div>

            <div id="paymentError" class="validation-message" style="display:none">
                @(Model.IsVietnamese
                    ? "Vui lòng chọn hình thức thanh toán."
                    : "Please select a payment method.")
            </div>

        </section>

        <div class="payment-actions">

            <button type="button"
                    class="action-button back-button"
                    id="backButton">
                ← @(Model.IsVietnamese ? "Quay lại" : "Back")
            </button>

            <button type="button"
                    class="action-button pay-button"
                    id="payButton">
                @(Model.IsVietnamese ? "Thanh toán" : "Pay")
            </button>

        </div>

    </main>
</div>

<form id="paymentForm" method="post" asp-page-handler="Pay" style="display:none">
    <input type="hidden" name="destination" value="@Model.Destination" />
    <input type="hidden" name="tripType" value="@Model.TripType" />
    <input type="hidden" name="language" value="@Model.Language" />
    <input type="hidden" name="quantity" id="paymentQuantity" value="1" />
    <input type="hidden" name="paymentMethod" id="paymentMethod" value="" />
</form>

<script>
    const ticketPrice = Number(
        document.getElementById("ticketPrice").dataset.price
    );

    let quantity = 1;
    let paymentMethod = "";

    const isVietnamese = @Json.Serialize(Model.IsVietnamese);

    function formatPrice(price) {
        return price.toLocaleString("vi-VN") + " đ";
    }

    function updateTotal() {
        document.getElementById("quantity").textContent = quantity;
        document.getElementById("summaryQuantity").textContent = quantity;

        document.getElementById("totalPrice").textContent =
            formatPrice(ticketPrice * quantity);

        document.getElementById("decrease").disabled = quantity <= 1;
    }

    document.getElementById("decrease").addEventListener("click", function () {
        if (quantity > 1) {
            quantity--;
            updateTotal();
        }
    });

    document.getElementById("increase").addEventListener("click", function () {
        if (quantity < 5) {
            quantity++;
            updateTotal();
        }
    });

    document.querySelectorAll(".method-button").forEach(function (button) {
        button.addEventListener("click", function () {
            document.querySelectorAll(".method-button").forEach(function (item) {
                item.classList.remove("selected");
            });

            this.classList.add("selected");
            paymentMethod = this.dataset.method;

            document.getElementById("paymentError").style.display = "none";
        });
    });

    document.getElementById("backButton").addEventListener("click", function () {
        const params = new URLSearchParams({
            destination: @Json.Serialize(Model.Destination),
            tripType: @Json.Serialize(Model.TripType),
            language: @Json.Serialize(Model.Language)
        });
        window.location.href = "/?" + params.toString();
    });

    document.getElementById("payButton").addEventListener("click", function () {
        if (paymentMethod === "") {
            document.getElementById("paymentError").style.display = "block";
            return;
        }

        document.getElementById("paymentQuantity").value = quantity;
        document.getElementById("paymentMethod").value = paymentMethod;

        this.disabled = true;
        this.textContent = isVietnamese ? "Đang chuyển..." : "Redirecting...";

        document.getElementById("paymentForm").submit();
    });

    updateTotal();

    let idleTimer;
    function resetIdle() {
        clearTimeout(idleTimer);
        idleTimer = setTimeout(function () { window.location.href = "/"; }, 5 * 60 * 1000);
    }
    ["click", "touchstart", "keydown", "mousemove"].forEach(function (e) {
        document.addEventListener(e, resetIdle);
    });
    resetIdle();
</script>
</body>
</html>